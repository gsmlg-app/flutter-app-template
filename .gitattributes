# Git configuration

# Text files
*.yaml text
*.yml text
*.json text
*.dart text
*.md text
*.arb text

# Lock files - allow standard text diffs
pubspec.lock text
Podfile.lock text
Gemfile.lock text

# Images and binaries - Git LFS for large media
*.psd filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text


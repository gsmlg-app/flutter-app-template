# Git configuration

# Text files
*.yaml text
*.yml text
*.json text
*.dart text
*.md text
*.arb text

# Lock files - allow standard text diffs
pubspec.lock text
Podfile.lock text
Gemfile.lock text

# Standard binary formats (no LFS)
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary

# Large media files - Git LFS
*.psd filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text

